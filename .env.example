# Copy to .env and fill in local values. Never commit .env.
# All apps read this single root file. Only VITE_* variables reach the browser.

# ---- API (apps/api) ----
# NODE_ENV is intentionally not set here: Vite also reads this file, and NODE_ENV=development
# would make `vite build` bundle React's development build. The API defaults to development;
# set NODE_ENV=production in the deployment environment instead.
API_PORT=4000
# Exact frontend origin allowed by CORS (no wildcards; credentials are enabled).
WEB_ORIGIN=http://localhost:5173
# PostgreSQL connection string used by the API and Prisma.
DATABASE_URL=postgresql://<user>:<password>@localhost:5432/smart_tourism?schema=public
# Separate database for automated tests. Its name must contain "test"; tests apply
# migrations to it and upsert seed data, so never point it at real data.
TEST_DATABASE_URL=postgresql://<user>:<password>@localhost:5432/smart_tourism_test?schema=public
# Set true only when served over HTTPS. Forced true when NODE_ENV=production.
COOKIE_SECURE=false
# Forecast provider: "demo" (default) or "http" (teammate's FastAPI model service).
FORECAST_PROVIDER=demo
# Only used when FORECAST_PROVIDER=http.
ML_SERVICE_URL=http://localhost:8000
ML_SERVICE_TIMEOUT_MS=3000
LOG_LEVEL=info

# ---- Web (apps/web) ----
# Where the Vite dev server proxies /api requests.
VITE_API_PROXY_TARGET=http://localhost:4000

# ---- Docker Compose PostgreSQL (optional) ----
POSTGRES_USER=<user>
POSTGRES_PASSWORD=<password>
POSTGRES_DB=smart_tourism
